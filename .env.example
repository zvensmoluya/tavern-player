# Local real-provider verification only.
# Copy this file to .env and replace the placeholder values.
# Never commit the populated .env file.

TAVERN_TEST_BASE_URL=https://api.example.com/v1
TAVERN_TEST_API_KEY=replace-me

# Supported values:
# OPENAI_RESPONSES
# OPENAI_CHAT_COMPLETIONS
# ANTHROPIC_MESSAGES
# GEMINI_INTERACTIONS
# GEMINI_GENERATE_CONTENT
TAVERN_TEST_PROTOCOL=OPENAI_CHAT_COMPLETIONS

# Optional when the provider exposes a compatible model catalog.
TAVERN_TEST_MODEL=

# Optional independent model for import-time adaptation experiments.
# Live compilation tests run only with TAVERN_COMPILER_LIVE=1 in the test process environment.
TAVERN_TEST_BASE_URL_1=https://api.example.com/v1
TAVERN_TEST_API_KEY_1=replace-me
TAVERN_TEST_PROTOCOL_1=OPENAI_RESPONSES
TAVERN_TEST_MODEL_1=
